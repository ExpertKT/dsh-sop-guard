{
  "name": "dsh-sop-guard",
  "version": "1.0.0",
  "description": "把 skill 目录里的 SOP.json 变成真正的分步白名单：模型必须先申报自己在第几步，改文件、跑命令、跑代码的范围由插件在工具执行前卡住。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "DESIGN.md",
    "LICENSE",
    "test/guard.test.mjs",
    "examples/sop-demo/SKILL.md",
    "examples/sop-demo/SOP.json"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sop",
    "agent-workflow",
    "tool-gate"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExpertKT/dsh-sop-guard.git"
  },
  "bugs": {
    "url": "https://github.com/ExpertKT/dsh-sop-guard/issues"
  },
  "homepage": "https://github.com/ExpertKT/dsh-sop-guard#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node test/guard.test.mjs"
  },
  "meta": {
    "title": "SOP Guard",
    "description": "按当前 SOP 步骤的工具与命令白名单核对每一次受管调用。申报管整步；推进既要有 evidence，也要宿主真观察到执行。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
